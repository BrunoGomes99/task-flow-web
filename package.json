{
  "name": "task-flow-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "private": true,
  "engines": {
    "node": "^24.15.0"
  },
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.5",
    "angular-eslint": "22.7.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.6.1",
    "postcss": "^8.5.33",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{css,js,mjs,cjs,json,md}": "prettier --write"
  }
}
